{
  "brand": {
    "name": "SHAYA",
    "system": "Signal Color",
    "version": "1.0",
    "tagline": "Stay curious. Look closer.",
    "idea": "Curiosity made visible."
  },
  "color": {
    "cobalt": "#0231B1",
    "warmWhite": "#F6F3EC",
    "ink": "#151514",
    "turquoise": "#03AEA9",
    "vermilion": "#FE4B05",
    "marigold": "#FCAB05",
    "indigo": "#3B1F73"
  },
  "typography": {
    "display": "Impact",
    "condensed": "Arial Narrow Bold",
    "body": "Arial",
    "mono": "Cascadia Mono"
  },
  "logo": {
    "clearSpaceRatio": 0.25,
    "minimumDigitalSizePx": 32,
    "minimumPrintSizeMm": 10,
    "sourceFormat": "SVG",
    "fallbackFormat": "PNG",
    "viewBox": [
      0,
      0,
      145,
      158
    ],
    "wordmarkTextTreatment": "outlined paths"
  },
  "github": {
    "heroWidthPx": 1280,
    "heroHeightPx": 480,
    "identityRailMaximumRatio": 0.34
  },
  "texture": {
    "style": "subtle screen-print grain",
    "opacityMinimum": 0.03,
    "opacityMaximum": 0.12
  },
  "motion": {
    "cameraEasing": "cubic-bezier(0.65, 0, 0.35, 1)",
    "sequence": [
      "hold",
      "ease-in",
      "staggered-detail",
      "clear-frame",
      "ease-out"
    ],
    "surfaceRule": "Moving details stay attached to a physical surface."
  },
  "assetPolicy": {
    "vectorMasters": [
      "mark-light",
      "mark-dark",
      "avatar",
      "wordmark-cobalt",
      "wordmark-light",
      "palette",
      "logo-clear-space",
      "type-display",
      "pattern"
    ],
    "rasterArtwork": [
      "hero-1280x480",
      "detail-1280x480",
      "hero-animated"
    ],
    "rule": "Use SVG for identity geometry. Keep textured art and GIF frames raster."
  }
}
